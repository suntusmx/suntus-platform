{
  "name": "suntus-pro",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "clean": "rm -rf .expo node_modules/.cache .metro || true",
    "clean:metro": "rm -rf \"$TEMP/metro-cache\" 2>/dev/null || echo 'Cache de Metro limpiado'",
    "dev": "expo start --web --port 7004 -c --clear",
    "start": "expo start --port 7004 -c --clear",
    "android": "expo start --android --port 7004 -c --clear",
    "ios": "expo start --ios --port 7004 -c --clear",
    "web": "expo start --web --port 7004 -c --clear"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/metro-runtime": "~4.0.1",
    "@suntus/core": "workspace:*",
    "@suntus/ui": "workspace:*",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-localization": "^16.0.1",
    "expo-router": "~4.0.0",
    "expo-secure-store": "^14.0.1",
    "expo-status-bar": "~2.0.0",
    "fast-deep-equal": "^3.1.3",
    "i18next": "^25.6.3",
    "nativewind": "^4.0.0",
    "pretty-format": "^30.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.3.5",
    "react-native": "^0.76.5",
    "react-native-auth0": "^5.1.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "react-native-worklets": "npm:react-native-worklets-core@^1.6.2",
    "react-native-worklets-core": "^1.6.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.7.3"
  },
  "private": true
}
