// apps/suntus-services/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. USUARIOS Y ROLES (RBAC)
// ============================================

// SystemAdmin (God Mode) - NO usa Auth0
model SystemAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   // Bcrypt/Argon2
  name         String
  role         AdminRole
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auditoría (sin relación estricta - logs permanecen aunque se borre el admin)

  @@index([email])
  @@index([role])
  @@map("system_admins")
}

enum AdminRole {
  SUPER_ADMIN  // Acceso total
  SUPPORT      // Soporte limitado
}

// User (Mortales) - Solo Auth0
model User {
  id                String   @id @default(uuid())
  auth0Id           String?  @unique // ID de Auth0
  email             String   @unique
  phone             String?
  name              String
  role              UserRole
  countryCode       String?  // ISO 3166-1 alpha-2
  sexualOrientation String?
  isSuspended       Boolean  @default(false)
  language          String   @default("es") // es, en
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  expertProfile     ExpertProfile?
  clientProfile     ClientProfile?
  subscriptions     Subscription[]
  payments          Payment[]
  paymentTransactions PaymentTransaction[]
  medicalRecords    MedicalRecord[]
  measurements      Measurement[]
  assignedPlans     AssignedPlan[]
  termsAcceptances  TermsAcceptance[]
  expertHistory     ExpertHistory[]

  @@index([email])
  @@index([auth0Id])
  @@index([role])
  @@map("users")
}

enum UserRole {
  CLIENT  // Usuario final
  EXPERT  // Experto (entrenador/nutriólogo)
}

// ExpertProfile (Perfil de Experto)
model ExpertProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  stripeAccountId   String?  // ID de cuenta de Stripe
  isVerified        Boolean  @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  rankingScore      Float    @default(0.0)
  documentsUrl      Json?    // JSONB: { officialId: "path", accreditationDoc: "path" }
  specialties       String[] // Array de especialidades
  bio               Json?    // {"es": "...", "en": "..."}
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]
  exercises        Exercise[]
  wikiArticles     WikiArticle[]
  workoutTemplates  WorkoutTemplate[]
  nutritionPlans   NutritionPlan[]
  expertRanking    ExpertRanking?
  expertSubscription ExpertSubscription?
  questionTemplates QuestionTemplate[]
  medicalRecords    MedicalRecord[]
  expertHistory     ExpertHistory[]
  paymentTransactions PaymentTransaction[]
  activeClients     ClientProfile[] @relation("ActiveExpertClients")

  @@index([isVerified])
  @@index([verificationStatus])
  @@index([rankingScore])
  @@map("expert_profiles")
}

enum VerificationStatus {
  PENDING
  VALIDATED
  REJECTED
}

// ============================================
// 2. CATÁLOGO DE UBICACIONES
// ============================================

model Country {
  code      String   @id // ISO 3166-1 alpha-2
  name      Json     // {"es": "México", "en": "Mexico", "native": "México"}
  capital   String?
  currency  String[] // ISO 4217
  phone     Int[]    // Códigos de llamada
  continent String?
  createdAt DateTime @default(now())

  states    State[]

  @@map("countries")
}

model State {
  id          String   @id @default(uuid())
  countryCode String
  name        Json     // {"es": "Ciudad de México", "en": "Mexico City"}
  code        String?  // Código del estado
  createdAt   DateTime @default(now())

  country     Country  @relation(fields: [countryCode], references: [code])
  cities      City[]

  @@index([countryCode])
  @@map("states")
}

model City {
  id        String   @id @default(uuid())
  stateId   String
  name      Json     // {"es": "Ciudad de México", "en": "Mexico City"}
  createdAt DateTime @default(now())

  state     State    @relation(fields: [stateId], references: [id])
  municipalities Municipality[]

  @@index([stateId])
  @@map("cities")
}

model Municipality {
  id        String   @id @default(uuid())
  cityId    String
  name      Json
  createdAt DateTime @default(now())

  city      City     @relation(fields: [cityId], references: [id])
  postalCodes PostalCode[]

  @@index([cityId])
  @@map("municipalities")
}

model PostalCode {
  code          String   @id
  municipalityId String
  createdAt     DateTime @default(now())

  municipality  Municipality @relation(fields: [municipalityId], references: [id])

  @@index([municipalityId])
  @@map("postal_codes")
}

// ============================================
// 3. CATÁLOGO DE EJERCICIOS (Herramienta de Trabajo)
// ============================================

model Exercise {
  id          String        @id @default(uuid())
  creatorId   String?       // NULL = Sistema (Suntus HD), UUID = Experto
  visibility  ExerciseVisibility @default(PRIVATE)
  name        Json          // {"es": "Sentadilla", "en": "Squat"}
  description Json?         // {"es": "...", "en": "..."}
  mediaUrl   String?        // URL del video/imagen (bucket público)
  metadata    Json          // JSONB: { tags: [], muscles: [], equipment: [] }
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relaciones
  creator     ExpertProfile? @relation(fields: [creatorId], references: [id])
  routineBlocks RoutineBlock[]

  @@index([creatorId])
  @@index([visibility])
  @@map("exercises")
}

enum ExerciseVisibility {
  SYSTEM          // Ejercicio de Suntus (Global, visible para todos)
  PRIVATE         // Ejercicio del experto (solo él y sus clientes)
  PUBLIC_COMMUNITY // Ejercicio compartido por experto (visible para todos)
}

// ============================================
// 4. FITOTECA (Wiki & Comunidad)
// ============================================

model WikiArticle {
  id            String          @id @default(uuid())
  authorId      String
  title         String
  content       String          // Markdown
  category      WikiCategory
  tags          String[]        // Array para búsquedas
  reputationScore Int           @default(0) // Upvotes - Downvotes
  isVerifiedInfo Boolean        @default(false) // Check azul de Suntus
  views         Int             @default(0)
  likes         Int             @default(0)
  shares        Int             @default(0)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relaciones
  author        ExpertProfile   @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([category])
  @@index([reputationScore])
  @@index([publishedAt])
  @@map("wiki_articles")
}

enum WikiCategory {
  NUTRITION
  TRAINING
  PHARMACOLOGY
  PSYCHOLOGY
}

// ============================================
// 5. CARdex MÉDICO (Propiedad del Usuario)
// ============================================

model MedicalRecord {
  id        String          @id @default(uuid())
  userId    String          // OWNER del dato
  authorId  String          // Creator - Inmutable (ExpertProfile)
  type      MedicalRecordType
  content   Json            // JSONB: Datos estructurados
  createdAt DateTime        @default(now())

  // Relaciones
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  author    ExpertProfile   @relation(fields: [authorId], references: [id])

  @@index([userId])
  @@index([authorId])
  @@index([type])
  @@map("medical_records")
}

enum MedicalRecordType {
  MEASUREMENT      // Mediciones (peso, talla, etc.)
  INJURY          // Lesiones
  NOTE            // Notas médicas
  PROGRESS_PHOTO  // Fotos de progreso
  PLAN            // Plan nutricional/deportivo
}

model Measurement {
  id        String   @id @default(uuid())
  userId    String   // OWNER del dato
  date      DateTime
  data      Json     // JSONB: { weight: 70, height: 175, bodyFat: 15 }
  createdAt DateTime @default(now())

  // Relaciones
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("measurements")
}

// ============================================
// 6. RUTINAS Y DIETAS
// ============================================

model WorkoutTemplate {
  id            String   @id @default(uuid())
  expertId      String
  name          String
  weekStructure Json     // JSONB: Estructura de la semana (L-D con ejercicios)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  expert        ExpertProfile @relation(fields: [expertId], references: [id])
  assignedPlans AssignedPlan[]

  @@index([expertId])
  @@map("workout_templates")
}

model RoutineBlock {
  id          String   @id @default(uuid())
  exerciseId  String
  sets        Int?
  reps        Int?
  weight      Decimal?
  rest        Int?     // Segundos de descanso
  notes       String?
  order       Int      // Orden en la rutina

  // Relaciones
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@index([exerciseId])
  @@map("routine_blocks")
}

model AssignedPlan {
  id              String   @id @default(uuid())
  userId          String
  templateId      String?  // WorkoutTemplate (opcional)
  nutritionPlanId String?  // NutritionPlan (opcional)
  status          PlanStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        WorkoutTemplate? @relation(fields: [templateId], references: [id])
  nutritionPlan   NutritionPlan? @relation(fields: [nutritionPlanId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("assigned_plans")
}

enum PlanStatus {
  PENDING     // En progreso (experto creando)
  ACTIVE      // Activo
  PAUSED      // Pausado
  COMPLETED   // Completado
  CANCELLED   // Cancelado
}

model NutritionPlan {
  id          String   @id @default(uuid())
  expertId    String
  name        String
  structure   Json     // JSONB: Calendario semanal, comidas, recetas, equivalentes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  expert      ExpertProfile @relation(fields: [expertId], references: [id])
  assignedPlans AssignedPlan[]

  @@index([expertId])
  @@map("nutrition_plans")
}

// ============================================
// 7. SUSCRIPCIONES Y PAGOS
// ============================================

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  expertId        String
  serviceType     ServiceType
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  amount          Decimal
  cycle           BillingCycle
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert          ExpertProfile @relation(fields: [expertId], references: [id])
  payments        Payment[]
  templateAnswers TemplateAnswer[]

  @@index([userId])
  @@index([expertId])
  @@index([status])
  @@map("subscriptions")
}

enum ServiceType {
  NUTRITION
  TRAINING
  BOTH
}

enum SubscriptionStatus {
  PENDING     // Usuario pagó pero no completó templates
  ACTIVE      // Activa
  PAUSED      // Pausada
  CANCELLED   // Cancelada
  EXPIRED     // Expirada
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  expertId        String
  subscriptionId  String?
  amount          Decimal  // Monto total pagado
  suntusCommission Decimal // Comisión de suntUS (calculada según "Beca del 6to")
  expertPayout    Decimal  // Pago al experto (después de comisión)
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?  // ID de pago en Stripe
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  // Relaciones
  user            User     @relation(fields: [userId], references: [id])
  expert          ExpertProfile @relation(fields: [expertId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  transactions    PaymentTransaction[]

  @@index([userId])
  @@index([expertId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model ExpertSubscription {
  id                String   @id @default(uuid())
  expertId          String   @unique
  activeUsersCount  Int      @default(0)
  totalRevenue      Decimal  @default(0)
  totalCommission   Decimal  @default(0)
  totalPayout       Decimal  @default(0)
  updatedAt         DateTime @updatedAt

  // Relaciones
  expert            ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@map("expert_subscriptions")
}

model ExpertPayout {
  id            String   @id @default(uuid())
  expertId      String
  totalAmount   Decimal
  status        PayoutStatus @default(PENDING)
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  // Relaciones
  expert        ExpertProfile @relation(fields: [expertId], references: [id])

  @@index([expertId])
  @@index([status])
  @@map("expert_payouts")
}

enum PayoutStatus {
  PENDING
  PROCESSED
  FAILED
}

// ============================================
// 8. TEMPLATES DE PREGUNTAS
// ============================================

model QuestionTemplate {
  id          String   @id @default(uuid())
  expertId    String
  type        TemplateType
  questions   Json     // JSONB: Array de preguntas configurables
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  expert      ExpertProfile @relation(fields: [expertId], references: [id])
  answers     TemplateAnswer[]

  @@index([expertId])
  @@index([type])
  @@map("question_templates")
}

enum TemplateType {
  PERSONAL    // Preguntas personales
  NUTRITION   // Preguntas de nutrición
  TRAINING    // Preguntas deportivas
}

model TemplateAnswer {
  id              String   @id @default(uuid())
  subscriptionId  String
  templateId      String
  answers         Json     // JSONB: Respuestas del usuario
  createdAt       DateTime @default(now())

  // Relaciones
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  template        QuestionTemplate @relation(fields: [templateId], references: [id])

  @@index([subscriptionId])
  @@index([templateId])
  @@map("template_answers")
}

// ============================================
// 9. RECETAS Y MACROS (Mago Nutricional)
// ============================================

model Recipe {
  id          String        @id @default(uuid())
  name        Json          // {"es": "Pechuga de pollo", "en": "Chicken breast"}
  macros      Json          // {"protein": 30, "carbs": 50, "fat": 20, "calories": 400}
  equivalents Json?         // {"proteins": 2, "carbs": 3} (equivalencias)
  ingredients Json          // Lista de ingredientes traducida
  instructions Json         // Instrucciones traducidas
  imageUrl    String?
  source      RecipeSource  @default(SYSTEM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([source])
  @@map("recipes")
}

enum RecipeSource {
  SYSTEM  // Recetas de suntUS
  EXPERT  // Recetas creadas por expertos
}

model MacroEquivalent {
  id    String     @id @default(uuid())
  type  MacroType
  unit  String     // "2 Proteínas" = 30 gramos
  grams Decimal    // Gramos equivalentes

  @@unique([type, unit])
  @@map("macro_equivalents")
}

enum MacroType {
  PROTEIN
  CARB
  FAT
}

// ============================================
// 10. RANKING Y REPUTACIÓN
// ============================================

model ExpertRanking {
  id                    String   @id @default(uuid())
  expertId              String   @unique
  verificationScore     Int      @default(0) // +100 si verificado
  reputationScore       Int      @default(0) // Hasta +50 (rating)
  salesVolumeScore      Int      @default(0) // Hasta +30 (usuarios activos)
  fitotecaContribution  Int      @default(0) // Hasta +20 (artículos)
  totalScore            Int      @default(0) // Suma de todos
  lastUpdated           DateTime @updatedAt

  // Relaciones
  expert                ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([totalScore])
  @@map("expert_rankings")
}

// ============================================
// 11. TÉRMINOS Y CONDICIONES
// ============================================

model TermsAndConditions {
  id          String   @id @default(uuid())
  version     String   @unique // "1.0", "1.1", "2.0" (semantic versioning)
  title       Json     // {"es": "...", "en": "..."}
  content     Json     // Contenido traducido
  isActive    Boolean  @default(false) // Solo una versión activa
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  // Relaciones
  acceptances TermsAcceptance[]

  @@index([isActive])
  @@map("terms_and_conditions")
}

model TermsAcceptance {
  id        String   @id @default(uuid())
  userId    String
  termsId   String
  version   String   // Versión aceptada
  acceptedAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  // Relaciones
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms     TermsAndConditions @relation(fields: [termsId], references: [id])

  // IMPORTANTE: Esta tabla también es append-only
  @@unique([userId, termsId]) // Un usuario solo puede aceptar una versión una vez
  @@index([userId])
  @@index([version])
  @@map("terms_acceptances")
}

// ============================================
// 12. AUDITORÍA (Blindaje Legal)
// ============================================

model AuditLog {
  id          String     @id @default(uuid())
  entityType  String     // "WorkoutPlan", "TermsAndConditions", "User", "Expert", "Payment", etc.
  entityId    String     // UUID del objeto modificado
  action      AuditAction
  actorId     String     // UUID de quién ejecutó la acción (User, ExpertProfile, SystemAdmin)
  actorType   ActorType
  actorName   String?    // Snapshot del nombre del actor (para blindaje - permanece aunque se borre)
  actorEmail  String?    // Snapshot del email del actor (opcional, para auditoría)
  snapshot    Json       // JSONB: Copia exacta del dato antes y después
  ipAddress   String?
  userAgent   String?
  metadata    Json?      // JSONB: Datos adicionales
  timestamp   DateTime   @default(now())

  // IMPORTANTE: NO hay relaciones estrictas (FK) para blindaje total.
  // Si se borra un usuario/admin/expert, el log PERMANECE intacto.
  // actorId, actorName y actorEmail son suficientes para auditoría.
  
  // IMPORTANTE: Esta tabla es APPEND ONLY. Nunca se borra ni se edita.
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE      // Creación de entidad
  UPDATE      // Actualización de entidad
  DELETE      // Eliminación (soft delete también se registra)
  ACCEPT      // Aceptación (T&C, términos, etc.)
  REJECT      // Rechazo (validación de experto, etc.)
  APPROVE     // Aprobación (validación, etc.)
  SUSPEND     // Suspensión de cuenta
  UNSUSUSPEND // Reactivación de cuenta
  PAYMENT     // Procesamiento de pago
  REFUND      // Reembolso
  ACCESS      // Acceso a datos sensibles (documentos privados)
  EXPORT      // Exportación de datos
}

enum ActorType {
  USER        // Usuario final (User con role CLIENT)
  EXPERT      // Experto (ExpertProfile)
  ADMIN       // SystemAdmin (suntus-admin, NO usa Auth0)
  SYSTEM      // Acción automática del sistema
}

// ============================================
// 13. PERFIL DE CLIENTE E HISTORIAL DE EXPERTOS
// ============================================

// ClientProfile: Solo guarda el experto activo actual
model ClientProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  activeExpertId String?  // FK a ExpertProfile (experto actual)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeExpert  ExpertProfile? @relation("ActiveExpertClients", fields: [activeExpertId], references: [id], onDelete: SetNull)

  @@index([activeExpertId])
  @@map("client_profiles")
}

// ExpertHistory: Historial completo de relaciones Cliente-Experto
model ExpertHistory {
  id          String   @id @default(uuid())
  userId      String   // Cliente
  expertId    String   // Experto
  startDate   DateTime
  endDate     DateTime? // NULL si es la relación actual
  status      ExpertHistoryStatus @default(ACTIVE)
  reason      String?  // Razón de finalización (opcional)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert      ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expertId])
  @@index([status])
  @@index([startDate])
  @@map("expert_history")
}

enum ExpertHistoryStatus {
  ACTIVE      // Relación activa actual
  ENDED       // Relación finalizada normalmente
  CANCELLED   // Relación cancelada
}

// ============================================
// 14. TRAZO DEL DINERO (Contabilidad Interna)
// ============================================

// PaymentTransaction: Registro detallado de cada transacción para contabilidad
model PaymentTransaction {
  id              String   @id @default(uuid())
  userId          String   // Cliente que pagó
  expertId        String   // Experto que recibió el servicio
  subscriptionId  String?  // Suscripción relacionada (opcional)
  paymentId       String?  // Referencia al Payment original (opcional)
  amount          Decimal  // Monto total pagado por el cliente
  suntusFee       Decimal  // Comisión de suntUS (calculada según "Beca del 6to")
  expertPayout    Decimal  // Pago al experto (amount - suntusFee)
  status          PaymentTransactionStatus @default(PENDING)
  stripePaymentId String?  // ID de pago en Stripe
  stripeFee        Decimal? // Fee de Stripe (opcional, para contabilidad completa)
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert          ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // IMPORTANTE: Esta tabla es para contabilidad interna.
  // Registra cada cobro con desglose de comisiones y pagos.
  @@index([userId])
  @@index([expertId])
  @@index([status])
  @@index([createdAt])
  @@index([processedAt])
  @@map("payment_transactions")
}

enum PaymentTransactionStatus {
  PENDING     // Transacción pendiente
  COMPLETED   // Transacción completada
  FAILED      // Transacción fallida
  REFUNDED    // Transacción reembolsada
  CANCELLED   // Transacción cancelada
}
